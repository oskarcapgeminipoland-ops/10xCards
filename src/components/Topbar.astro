---
import { t } from "@/lib/i18n";

const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/ustawienia" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.settings}
          </a>
          <a href="/flashcards" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.flashcards}
          </a>
          <a
            href="/flashcards/generate"
            class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            {t.nav.generate}
          </a>
          <a href="/flashcards/review" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.review}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              {t.nav.signOut}
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">{t.nav.notSignedIn}</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.signIn}
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.signUp}
          </a>
        </div>
      </>
    )
  }
</div>
