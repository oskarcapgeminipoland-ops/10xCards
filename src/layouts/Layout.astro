---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Footer from "@/components/Footer.astro";
import { missingConfigs } from "@/lib/config-status";
import { Toaster } from "@/components/ui/sonner";
import { t } from "@/lib/i18n";

interface Props {
  title?: string;
}

const { title = t.meta.defaultTitle } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
    <Footer />
    <Toaster client:load theme="dark" richColors closeButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
