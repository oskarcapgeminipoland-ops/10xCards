---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import FlashcardDeck from "@/components/flashcards/FlashcardDeck";
---

<Layout title="Flashcards">
  <div class="bg-cosmic min-h-screen p-4 sm:p-6 lg:p-8">
    <div class="mx-auto w-full max-w-3xl">
      <Topbar />
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Your flashcards
      </h1>
      <FlashcardDeck client:load />
    </div>
  </div>
</Layout>
