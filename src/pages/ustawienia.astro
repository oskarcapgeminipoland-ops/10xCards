---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { t } from "@/lib/i18n";

const { user } = Astro.locals;
---

<Layout title={t.meta.titleSettings}>
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-6">
    <div class="w-full max-w-3xl">
      <Topbar />
    </div>
    <div class="mt-6 w-full max-w-3xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.settings.heading}
      </h1>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold text-white">{t.settings.accountTitle}</h2>
        <p class="text-sm text-blue-100/80">
          {t.settings.signedInAs}
          <span class="font-semibold text-white">{user?.email}</span>
        </p>
        <form method="POST" action="/api/auth/signout" class="mt-6">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            {t.settings.signOut}
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
